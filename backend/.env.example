# Comments stay on their own lines: `docker run --env-file` doesn't strip inline ones.

# real | fake (fake = no API calls, used by tests and CI)
AI_PROVIDER=real
# Free Gemini key from https://aistudio.google.com/apikey (only in .env, never committed)
GOOGLE_API_KEY=AIza...
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DATA_DIR=data
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_RELEVANCE_SCORE=0.3
