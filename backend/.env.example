AI_PROVIDER=real              # real | fake (fake = no API calls, used by tests/CI)
ANTHROPIC_API_KEY=sk-ant-...  # only in .env, never in .env.example
LLM_MODEL=claude-haiku-4-5    # cheap and fast for development
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DATA_DIR=data
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_RELEVANCE_SCORE=0.3
