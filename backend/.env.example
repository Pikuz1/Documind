AI_PROVIDER=real              # real | fake (fake = no API calls, used by tests/CI)
GOOGLE_API_KEY=AIza...         # free-tier Gemini key (aistudio.google.com/apikey), only in .env
LLM_MODEL=gemini-3.8-flash    # free-tier model used for the app's answers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DATA_DIR=data
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_RELEVANCE_SCORE=0.3
