# Keep the build context small and never copy secrets or local data into the image.
.git
**/.env
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.coverage
backend/.venv
backend/data
backend/.e2e-data
backend/tests
backend/scripts
backend/eval
frontend/node_modules
frontend/dist
frontend/coverage
frontend/test-results
frontend/playwright-report
docs
